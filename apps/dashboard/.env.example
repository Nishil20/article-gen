# Supabase Configuration
# Get these from your Supabase project settings at https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# OpenAI Configuration
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# OpenAI Model Selection (optional - defaults to gpt-3.5-turbo)
# Options: gpt-3.5-turbo, gpt-4o, gpt-4-turbo
OPENAI_MODEL=gpt-3.5-turbo

# OpenAI Temperature (optional - defaults to 0.7)
# Range: 0.0 (focused) to 1.0 (creative)
OPENAI_TEMPERATURE=0.7

# OpenAI Max Tokens (optional - per tool defaults)
# OPENAI_MAX_TOKENS_PARAGRAPH=2000
# OPENAI_MAX_TOKENS_REWRITE=3000
# OPENAI_MAX_TOKENS_ARTICLE=4000

# WordPress Integration
# Encryption key for securing WordPress passwords in database
# Generate a secure random key at least 32 characters long
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORDPRESS_ENCRYPTION_KEY=your-encryption-key-here
